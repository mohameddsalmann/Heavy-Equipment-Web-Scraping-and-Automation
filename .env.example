# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MONITOR_INTERVAL_SECONDS=120

# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/equipment_monitor
REDIS_URL=redis://redis:6379/0

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Provider Configuration
MACHINERYTRADER_ENABLED=true
MACHINIO_ENABLED=true
FACEBOOK_MARKETPLACE_ENABLED=false
FACEBOOK_PROVIDER_API_KEY=
FACEBOOK_PROVIDER_ENDPOINT=
